{

    "name": "api-automation-mocha",

    "version": "1.0.0",

    "description": "Belajar API Automation",

    "type": "module",

    "scripts": {

      "test": "mocha test --recursive --timeout 5000 --reporter spec",
      "test-report-html": "mocha test --recursive --reporter mocha-simple-html-reporter --reporter-options output=report.html",
      "test-report-json": "mocha test --recursive --reporter json > test-results.json"

    },

    "dependencies": {

      "node-fetch": "^3.3.1",

      "ajv": "^8.12.0"

    },

    "devDependencies": {

      "node-fetch": "^3.3.1",

      "ajv": "^8.12.0",

      "mocha": "^10.2.0",

      "chai": "^4.3.8",

      "mocha-simple-html-reporter": "^2.0.0"

    }

  }